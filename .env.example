# Optional LLM provider settings.
# The app runs without these values using deterministic local agents.
SUPPORT_DESK_USE_LLM=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Runtime settings.
SUPPORT_DESK_HOST=127.0.0.1
# Hosted platforms often inject PORT. SUPPORT_DESK_PORT overrides PORT when set.
SUPPORT_DESK_PORT=8080
SUPPORT_DESK_DB=.data/support_desk.sqlite3
SUPPORT_DESK_DATABASE_URL=
SUPPORT_DESK_KNOWLEDGE_PATH=data/knowledge_base.json
SUPPORT_DESK_OCR_COMMAND=
SUPPORT_DESK_OCR_TIMEOUT=30

# Optional OAuth app client IDs for provider installation flows.
GMAIL_CLIENT_ID=
SLACK_CLIENT_ID=
ZENDESK_CLIENT_ID=
ZENDESK_SUBDOMAIN=
ZENDESK_AUTHORIZE_URL=
GITHUB_CLIENT_ID=
DISCORD_CLIENT_ID=
