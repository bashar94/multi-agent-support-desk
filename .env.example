# Optional LLM provider settings.
# The app runs without these values using deterministic local agents.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Runtime settings.
SUPPORT_DESK_HOST=127.0.0.1
SUPPORT_DESK_PORT=8080
SUPPORT_DESK_DB=.data/support_desk.sqlite3
